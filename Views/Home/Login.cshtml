@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <link rel="stylesheet" href="~/css/auth.css" />
</head>

<body>

    <div class="container">

        <h2>Welcome back</h2>
        <div class="subtitle">Please enter your details</div>

        
        @if (TempData["AlreadyRegistered"] != null)
        {
            <div class="alert alert-warning text-center">
                @TempData["AlreadyRegistered"]
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger text-center">
                @TempData["Error"]
            </div>
        }
        
        @if (ViewBag.Error != null)
        {
            <p style="color:red; font-weight:bold;">
                @ViewBag.Error
            </p>
        }

        @if (ViewBag.Success != null)
        {
            <p style="color:green; font-weight:bold;">
                @ViewBag.Success
            </p>
        }


        <form method="post" asp-action="Login">

            
            <input type="email" name="Email" placeholder="Enter email" />
            <input type="password" name="Password" placeholder="Enter password" />

            <div class="options">


                @* <a asp-controller="Home" asp-action="ForgotPassword">
                    Forgot password?
                </a> *@

            </div>



            <button class="btn">Sign in</button>

           
            


            
            <div class="footer">
                Don't have an account?
                <a asp-controller="Home" asp-action="Register">Sign up</a>
            </div>

        </form>

    </div>

</body>
</html>