@model List<SmartKart.Models.SupportCase> 


@{
    ViewData["Title"] = "My Cases";
}

<div class="container mt-5">
    <h2 class="mb-4">My Cases</h2>

    <div class="card shadow-sm p-4">
        @if (Model.Count == 0)
        {
            <p>No cases raised yet.</p>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                      
                        <th> Type</th>
                        <th>Order ID</th>
                        <th>Description</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CaseType</td>
                                <td>@item.OrderId</td>
                                <td>@item.CaseTitle</td>
                                <td>@item.Status</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align:center;">No cases found</td>
                        </tr>
                    }
                </tbody>
                
            </table>
        }
    </div>
</div>