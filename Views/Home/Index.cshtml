        <div class="carousel-item active">
            <div class="d-flex align-items-center"
                 style="
                background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
                url('@Url.Content("/Images/Welcome.png")');
                background-size: cover;
                background-position: center;
                height:300px;
                border-radius:16px;
                color:white;
                ">

                <div class="ms-5" style="max-width:500px;">

                    <h1 class="fw-bold" style="font-size:38px;">
                        SmartKart
                    </h1>

                    <p class="mb-3">
                        Shop Smart. Live Better.
                    </p>

                    <a asp-controller="Home" asp-action="Electronics"
                       class="btn btn-light">
                        Shop Now →
                    </a>

                </div>

            </div>
        </div>
