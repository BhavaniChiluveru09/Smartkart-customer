@model List<SmartKart.Models.CartItem>


@{
    ViewData["Title"] = "Cart";
    var subtotal = Model.Sum(item => item.Total);
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["Error"]
    </div>
}


<h2 class="mb-4">My Cart</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Image</th>
                <th>Price</th>
                <th class="text-center">Qty</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>

                    <td>
                        <img src="@Url.Content(item.Image)"
                             style="width:70px; height:70px; object-fit:contain;" />
                    </td>

                    <td>₹@item.Price</td>

                        @* <div class="d-flex justify-content-center align-items-center">

                            <a asp-controller="Home"
                               asp-action="DecreaseQty"
                               asp-route-name="@item.Name"
                               class="btn btn-sm btn-outline-danger"
                               style="width:32px;">−</a>

                            <span class="mx-2 fw-bold">
                                @item.Quantity
                            </span>

                            <a asp-controller="Home"
                               asp-action="IncreaseQty"
                               asp-route-name="@item.Name"
                               class="btn btn-sm btn-outline-success"
                               style="width:32px;">+</a>

                        </div> *@
                        <td class="text-center align-middle" style="width:150px;">
                            <div class="d-flex justify-content-center align-items-center">

                                <a asp-controller="Home"
                                       asp-action="DecreaseQty"
                                       asp-route-cartId="@item.CartId"
                                       class="btn btn-sm btn-outline-danger"
                                       style="width:32px;">
                                    −
                                </a>

                                <span class="mx-3 fw-bold text-center" style="min-width:20px;">
                                    @item.Quantity
                                </span>

                            @if (item.Quantity >= item.Stock)
                            {
                                <button class="btn btn-sm btn-secondary"
                                        style="width:32px;"
                                        disabled>
                                    +
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Home"
                                       asp-action="IncreaseQty"
                                       asp-route-cartId="@item.CartId"
                                       class="btn btn-sm btn-outline-success"
                                       style="width:32px;">
                                    +
                                </a>
                            }

                            </div>
                        </td>
                    



                    <td>₹@item.Total</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Subtotal: ₹@subtotal</h4>

    <hr />

    <form method="post" asp-action="Checkout">
        <div class="mb-3">
            <label class="form-label">Address:</label>
            <input type="text"
                   name="address"
                   class="form-control"
                   placeholder="Enter your address" />
        </div>

        <button type="submit" class="btn btn-success">
            Proceed to Checkout
        </button>
    </form>
}