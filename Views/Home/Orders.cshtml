@* @model List<SmartKart.Models.Order> *@
@model dynamic


@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4">My Orders</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have not placed any orders yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Order Code</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Image</th>
                <th>Quantity</th>
                <th>Address</th>
                <th>Order Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderCode</td>
                    <td>@order.ProductName</td>
                    <td>₹@order.Price</td>
                    <td>
                        <img src="@order.Image" width="80" />
                    </td>
                    <td>@order.Quantity</td>
                    <td>@order.Address</td>
                    <td>@order.OrderDate</td>
                    <td>@order.OrderStatus</td>
                   
                    <td>
    @if (order.IsCancelled)
    {
        <span class="badge bg-danger">Cancelled</span>
    }
    else if (order.IsRefunded)
    {
        <span class="badge bg-warning text-dark">Refunded</span>
    }
    else if (order.OrderStatus == "Created" || order.OrderStatus == "Packed")
    {
        <form method="post" asp-action="CancelOrder" style="display:inline;">
            <input type="hidden" name="orderCode" value="@order.OrderCode" />
            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
        </form>
    }
    else if (order.OrderStatus == "Delivered")
    {
        <form method="post" asp-action="RefundOrder" style="display:inline;">
            <input type="hidden" name="orderCode" value="@order.OrderCode" />
            <button type="submit" class="btn btn-warning btn-sm">Refund</button>
        </form>
    }
    else
    {
        <span>-</span>
    }
</td>

                </tr>
            }
        </tbody>
    </table>
}

<script>
    setInterval(function () {
        window.location.reload();
    }, 10000); // 10 seconds
</script>