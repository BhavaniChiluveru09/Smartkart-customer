@{
    ViewData["Title"] = "Order Placed";
}

<div class="text-center mt-5">

    <!-- Tick Circle -->
    <div class="checkmark-circle">
        <div class="checkmark"></div>
    </div>

    <h2 class="mt-4 text-success">Order Placed Successfully </h2>

    <p>Your order has been placed successfully.</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        Continue Shopping
    </a>
    @* //for Order code *@
    @if (TempData["OrderCode"] != null)
    {
        <h3 style="color:green;">
             Your Order ID: @TempData["OrderCode"]
        </h3>
    }
    
</div>

<style>
    .checkmark-circle {
        width: 100px;
        height: 100px;
        position: relative;
        display: inline-block;
        vertical-align: top;
        border-radius: 50%;
        background: #28a745;
        animation: pop 0.5s ease forwards;
    }

    .checkmark {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 25px;
    height: 50px;

    border-right: 5px solid white;
    border-bottom: 5px solid white;

    transform: translate(-50%, -70%) rotate(45deg);
}

    @@keyframes pop {
        0% { transform: scale(0); }
        100% { transform: scale(1); }
    }

    @@keyframes draw {
        0% { height: 0; }
        100% { height: 50px; }
    }
</style>
